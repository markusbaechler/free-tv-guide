{
  "name": "free-tv-guide",
  "version": "0.1.0",
  "private": true,
  "description": "Free-TV- und Sport-Guide für Samsung Tizen (Schweiz)",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "pipeline": "node pipeline/main.ts",
    "test": "node --test \"pipeline/test/*.test.ts\" \"app/test/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p app/tsconfig.json",
    "app:build": "node app/build.mjs",
    "app:preview": "node app/build.mjs && node app/preview.mjs",
    "check": "npm run typecheck && npm test && npm run app:build",
    "app:standalone": "node app/build.mjs && node app/build-preview.mjs out out/free-tv-guide-vorschau.html"
  },
  "dependencies": {
    "@srgssr/pillarbox-web": "^1.40.4",
    "video.js": "^8.21.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "acorn": "^8.19.0",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3"
  }
}
